// Proposed Firestore security rules for the Alias / Hat Game.
//
// STATUS: MVP draft. Test these against the Firebase emulator before
// trusting them in production. The client UI hides word texts during
// collection, but these rules are what actually keep one player from
// reading another's words.
//
// Deploy with:
//   firebase deploy --only firestore:rules
//
// Highlights:
// - Anyone signed in (anonymous OK) can read the game document so
//   players can join by code.
// - Only the admin (creator) can mutate the game doc, teams, and
//   round state.
// - A player's own document is keyed by their uid; only they (and the
//   admin) can read/write it.
// - Word documents are readable only by their owner or the admin,
//   and only their owner can mutate them (and only before the hat is
//   locked).
//
// Known limitations / TODO:
// - There is no server-side enforcement of the "wordsPerPlayer" cap
//   or duplicate detection. For MVP we rely on the client; a Cloud
//   Function or transactional client write should enforce it.
// - "Admin" is identified by the adminUid field on the game doc.
//   For more robust admin auth, use Firebase custom claims.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function signedIn() {
      return request.auth != null;
    }
    function gameDoc(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId));
    }
    function isAdmin(gameId) {
      return signedIn() && gameDoc(gameId).data.adminUid == request.auth.uid;
    }
    function phaseAllowsWordEdit(gameId) {
      return gameDoc(gameId).data.phase == 'WORD_COLLECTION';
    }
    function phaseAllowsHatRead(gameId) {
      let phase = gameDoc(gameId).data.phase;
      return phase == 'HAT_LOCKED' ||
             phase == 'ROUND_1_READY' ||
             phase == 'ROUND_1_ACTIVE' ||
             phase == 'ROUND_1_TURN_VALIDATION' ||
             phase == 'ROUND_1_FINISHED';
    }

    // games/{gameId} — the room itself
    match /games/{gameId} {
      allow read: if signedIn();
      // Creator becomes admin. They write the doc with adminUid set
      // to their own uid; the rule below pins it.
      allow create: if signedIn() &&
                       request.resource.data.adminUid == request.auth.uid;
      allow update: if isAdmin(gameId) &&
                       // Admin cannot reassign the admin to someone else.
                       request.resource.data.adminUid == resource.data.adminUid;
      allow delete: if isAdmin(gameId);

      // games/{gameId}/players/{playerId}
      // playerId == player's uid by convention (see firebase-provider.js).
      match /players/{playerId} {
        allow read: if signedIn();
        // CREATE: a player may only register their own slot, and only
        // before registrationLocked is true. Admin can always create
        // (for adding-by-name flows if you reintroduce them).
        allow create: if signedIn() && (
          (request.auth.uid == playerId &&
           gameDoc(gameId).data.registrationLocked == false) ||
          isAdmin(gameId)
        );
        // UPDATE: a player may update their own slot (heartbeat,
        // connected, lastSeenAt). The admin can also update e.g.
        // teamId — but only before registration lock.
        allow update: if signedIn() && (
          (request.auth.uid == playerId) ||
          (isAdmin(gameId) &&
           gameDoc(gameId).data.registrationLocked == false)
        );
        allow delete: if isAdmin(gameId) &&
                         gameDoc(gameId).data.registrationLocked == false;
      }

      // games/{gameId}/teams/{teamId}
      match /teams/{teamId} {
        allow read: if signedIn();
        // Only the admin manages teams — and only while registration
        // is still open. Once locked, the team structure is frozen.
        allow write: if isAdmin(gameId) &&
                        gameDoc(gameId).data.registrationLocked == false;
      }

      // games/{gameId}/words/{wordId}
      // PRIVACY: a player may only read their own word texts before
      // the hat is locked. After lock the admin and all players may
      // read all words (needed for Round 1 public reveals).
      match /words/{wordId} {
        allow read: if signedIn() && (
          resource.data.ownerUid == request.auth.uid ||
          isAdmin(gameId) && phaseAllowsHatRead(gameId) ||
          phaseAllowsHatRead(gameId)
        );
        // Only the owner can create / update / delete, and only
        // during word collection.
        allow create: if signedIn() &&
                         request.resource.data.ownerUid == request.auth.uid &&
                         phaseAllowsWordEdit(gameId);
        allow update, delete: if signedIn() &&
                                 resource.data.ownerUid == request.auth.uid &&
                                 phaseAllowsWordEdit(gameId);
      }

      // games/{gameId}/rounds/{roundId}
      match /rounds/{roundId} {
        allow read: if signedIn();
        allow write: if isAdmin(gameId);

        match /turns/{turnId} {
          allow read: if signedIn();
          // Admin updates turn records; the active explainer needs to
          // append "guessed" actions, which requires either a Cloud
          // Function (recommended) or a more specific write rule.
          // For MVP we permit the active explainer to update — note
          // that this is wider than ideal; tighten before prod.
          allow write: if signedIn() && (
            isAdmin(gameId) ||
            request.auth.uid == gameDoc(gameId).data.activeExplainerUid
          );
        }
      }
    }
  }
}
